# Copy to .env (it is gitignored). Never commit real values: this file holds placeholders only.

# --- Application ---
APP_NAME=Real-Time Voice Agent
# development | staging | production
APP_ENV=development
# Tracebacks in the browser for unhandled errors. Ignored when APP_ENV=production.
DEBUG=true
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Database (required) ---
# PostgreSQL via psycopg. Replace user, password, host and database with your own.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/voice_agent

# --- LLM ---
# The key stays on the server and is never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# 0 = no thinking (fastest first word, right for voice); -1 = let the model decide.
# Some models cannot turn thinking off: set -1 for those.
GEMINI_THINKING_BUDGET=0
BRAIN_TIMEOUT_SECONDS=30

# --- Sign-in (operator console) ---
# On by default. Create the first user with:  python -m app.cli create-user you@example.com --role admin
# Set to false only for local development.
AUTH_REQUIRED=true
# Set true whenever the site is served over https (always, in production).
COOKIE_SECURE=false
# Behind a reverse proxy: how many proxies to trust for X-Forwarded-For (0 = none).
# TRUSTED_PROXY_HOPS=0
# Origins allowed to make signed-in writes (the frontend's address). JSON list.
# CORS_ORIGINS=["http://localhost:5173"]

# --- Outbound calling ---
# The business API (/api/call-jobs) stays closed until this is set. Use a long random value.
VOICE_AGENT_API_KEY=
# Signs result callbacks. Defaults to the API key.
# VOICE_AGENT_WEBHOOK_SECRET=
# Where callees open their answer link (the frontend's public address).
PUBLIC_BASE_URL=http://localhost:5173
# Development only: allow result callbacks to localhost / private addresses.
# ALLOW_PRIVATE_CALLBACKS=true

# --- Workflow scheduler ---
# Every interval it runs the active workflows and then places the calls that are due. OFF by default:
# turning it on lets this process ring people on its own. Enable it only where that is intended.
# WORKFLOW_SCHEDULER_ENABLED=false
# Seconds between ticks. Never faster than 60.
# WORKFLOW_SCHEDULER_INTERVAL_SECONDS=60
# Active workflows run per tick, and scheduled jobs looked at per tick.
# WORKFLOW_SCHEDULER_WORKFLOW_LIMIT=100
# WORKFLOW_SCHEDULER_DISPATCH_LIMIT=100

# --- Voice runtime ---
# Which runtime conducts a phone call, chosen once when the call starts. "legacy" is the one in production use.
# "pipecat" is opt-in and needs requirements-pipecat.txt; if it is asked for but not installed (or is not the
# pinned version) the call is conducted by the legacy runtime and a warning is logged.
# VOICE_RUNTIME=legacy
# With VOICE_RUNTIME=pipecat: only these agents' calls (comma-separated agent ids) use it. Empty = every call.
# VOICE_RUNTIME_PIPECAT_AGENT_IDS=
# Experimental, observation only, and only with VOICE_RUNTIME=pipecat. "observe" runs Pipecat's Silero VAD alongside a call and
# records when speech started and stopped. It does NOT affect turn detection or interruptions: Deepgram still ends each
# utterance. If the VAD cannot be created the call is conducted by the legacy runtime. Values: off | observe.
# VOICE_PIPECAT_VAD=off
# Experimental, and only with VOICE_RUNTIME=pipecat. "compat" (default) is the existing Deepgram recognizer, unchanged.
# "native" is Pipecat's own Deepgram STT, configured to match it (needs deepgram-sdk, in requirements-pipecat.txt); if it
# cannot be built the call uses "compat" instead, before any audio. Values: compat | native.
# VOICE_PIPECAT_STT=compat
